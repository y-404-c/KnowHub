# ===== App =====
APP_ENV=dev
APP_PORT=8000
APP_LOG_LEVEL=INFO

# ===== LLM Provider =====
# 选择: deepseek | qwen | openai
LLM_PROVIDER=openai

# 至少填一个, 其它可以留空
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# OpenAI 槽位可复用任意 OpenAI 兼容 endpoint（如 MiniMax / DeepSeek / 本地 ollama）
# 把下面的占位符换成你自己的 key
OPENAI_API_KEY=your-openai-compatible-key-here
OPENAI_BASE_URL=https://api.minimaxi.com/v1
OPENAI_MODEL=MiniMax-M3
# 关掉 M3/M2 默认 thinking (否则思考过程会被塞进 .content 当正文)
OPENAI_EXTRA_BODY={"thinking":{"type":"disabled"}}

# 本地面试演示：不调用外部 LLM，稳定跑通完整 RAG 问答链路。
UNIKB_FAKE_LLM=1
# 本地环境的 transformers/tokenizers 版本不匹配时，使用轻量嵌入实现完成检索演示。
UNIKB_FAKE_EMBEDDING=1

# Embedding (统一用 BGE, 离线可换 ollama)
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
RERANK_MODEL=BAAI/bge-reranker-base

# ===== Storage =====
# 默认本地 SQLite, 上线换 PostgreSQL
DATABASE_URL=sqlite:///./data/unikb.db
# DATABASE_URL=postgresql+psycopg2://unikb:unikb@postgres:5432/unikb

REDIS_URL=redis://localhost:6379/0

CHROMA_PERSIST_DIR=./data/chroma
FILE_STORAGE_DIR=./data/uploads
# BM25 倒排索引持久化目录 (落盘为 bm25_{kb_id}.pkl)
BM25_PERSIST_DIR=./data
# chromadb 在部分 Windows + Anaconda Python 下会 ACCESS_VIOLATION, 可临时切 numpy 兜底
VECTOR_STORE_BACKEND=numpy

# 注: 上面这些存储路径 (含 DATABASE_URL 的 sqlite 路径) 若写成相对路径,
# 都会按 backend/ 目录解析, 不再跟随进程的工作目录 (CWD)。这样 Docker WORKDIR、
# systemd 启动方式不同也不会把数据写到意料之外的位置。

# ===== Auth =====
JWT_SECRET=change-me-in-production-please-use-openssl-rand
JWT_ALGORITHM=HS256
JWT_EXPIRES_MIN=1440

# ===== Knowledge Base ACL =====
# 公共只读知识库白名单 (逗号分隔). 这些 kb_id 任何登录用户可读, 不可写入;
# 上传文档时会自动创建并归属当前用户 (私有). 默认含 "default" 以兼容 demo.
PUBLIC_KB_IDS=default

# ===== CORS =====
# 允许跨域的前端 origin 白名单 (逗号分隔). 严禁 "*" + credentials=True 的写法.
# 默认只允许本地 Next.js 开发服务器; 上线时改成线上域名, 多个用逗号分隔.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ===== MCP =====
# 是否对外提供内置 MCP server (python -m app.mcp.server [kb_id])
MCP_ENABLED=true
MCP_TRANSPORT=stdio
MCP_SERVER_NAME=knowhub

# ===== Observability (可选, 默认全部关闭, 不发任何外部请求) =====
# LangFuse: 自托管/SaaS 均可
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# LangSmith: LangChain/LangGraph 官方 tracing。
# 使用: 去 https://smith.langchain.com 拿 API key, 取消下面 4 行注释即可,
# 业务代码零改动, Agent 图每个节点和每次 LLM 调用都会自动出现在 LangSmith。
# langsmith 客户端随 langchain-core 自动安装, 无需额外 pip install。
#LANGCHAIN_TRACING_V2=true
#LANGCHAIN_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxxxxxxxxxx
#LANGCHAIN_PROJECT=KnowHub
#LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ===== Upload =====
# 单文件最大字节数. 超出时返回 413. 默认 25MB.
UPLOAD_MAX_BYTES=26214400
